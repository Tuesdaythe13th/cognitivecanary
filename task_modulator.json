{
  "metadata": {
    "version": "5.0",
    "name": "Cognitive Canary Task Modulator",
    "description": "Context-aware injection rules for adaptive adversarial defense",
    "author": "Cognitive Canary Project",
    "license": "MIT"
  },
  "injection_profiles": {
    "stealth_mode": {
      "description": "Minimal injection for low-risk environments (e.g., casual browsing)",
      "lissajous": {
        "enabled": true,
        "freq_ratio": [13, 8],
        "jitter_amplitude": 0.015,
        "injection_probability": 0.3
      },
      "spectral": {
        "enabled": false
      },
      "gradient_audit": {
        "enabled": true,
        "sensitivity": "low"
      }
    },
    "balanced_mode": {
      "description": "Standard protection for workplace/e-commerce (default)",
      "lissajous": {
        "enabled": true,
        "freq_ratio": [13, 8],
        "jitter_amplitude": 0.02,
        "injection_probability": 0.7
      },
      "spectral": {
        "enabled": true,
        "target_bands": ["alpha", "theta"],
        "injection_amplitude": 0.15,
        "phase_randomization": true
      },
      "gradient_audit": {
        "enabled": true,
        "sensitivity": "medium",
        "alert_threshold": 0.85
      }
    },
    "maximum_defense": {
      "description": "Aggressive protection for high-surveillance environments (e.g., HR monitoring, BCI headsets)",
      "lissajous": {
        "enabled": true,
        "freq_ratio": [13, 8],
        "jitter_amplitude": 0.025,
        "injection_probability": 1.0,
        "temporal_decorrelation": true
      },
      "spectral": {
        "enabled": true,
        "target_bands": ["alpha", "theta", "beta"],
        "injection_amplitude": 0.2,
        "phase_randomization": true,
        "temporal_coherence_break": true,
        "coherence_window_sec": 5
      },
      "gradient_audit": {
        "enabled": true,
        "sensitivity": "high",
        "alert_threshold": 0.75,
        "cross_session_monitoring": true
      }
    },
    "research_mode": {
      "description": "Transparent operation for auditing and research (injection logged but not applied)",
      "lissajous": {
        "enabled": false
      },
      "spectral": {
        "enabled": false
      },
      "gradient_audit": {
        "enabled": true,
        "sensitivity": "high",
        "log_only": true
      }
    }
  },
  "context_triggers": {
    "description": "Automatically adjust injection profile based on detected context",
    "triggers": [
      {
        "name": "bci_headset_detected",
        "condition": "device.type == 'EEG' OR device.vendor IN ['Muse', 'BrainCo', 'Neurable']",
        "action": "switch_to_profile('maximum_defense')",
        "reason": "BCI headsets enable direct neural profiling"
      },
      {
        "name": "hr_surveillance_platform",
        "condition": "url.contains('viva.microsoft.com') OR url.contains('palantir') OR url.contains('teamsync')",
        "action": "switch_to_profile('maximum_defense')",
        "reason": "Known workplace surveillance platforms detected"
      },
      {
        "name": "behavioral_analytics_script",
        "condition": "script.includes('mouseDynamics') OR script.includes('keystrokeDynamics') OR script.includes('behavioSec')",
        "action": "switch_to_profile('balanced_mode')",
        "reason": "Behavioral profiling scripts detected in page"
      },
      {
        "name": "high_value_transaction",
        "condition": "url.contains('/checkout') OR url.contains('/payment') OR session.value > 1000",
        "action": "switch_to_profile('stealth_mode')",
        "reason": "Minimize interference during critical transactions"
      },
      {
        "name": "gaming_or_creative",
        "condition": "app.category IN ['gaming', 'design', 'video_editing']",
        "action": "switch_to_profile('stealth_mode')",
        "reason": "Avoid degrading user experience in latency-sensitive tasks"
      }
    ]
  },
  "threat_database": {
    "description": "Known profiling systems and recommended countermeasures",
    "systems": [
      {
        "vendor": "BrainCo",
        "product": "Focus EDU",
        "attack_vector": "spectral_entropy",
        "recommended_profile": "maximum_defense",
        "notes": "Classroom attention monitoring via EEG headbands. Targets alpha/theta ratios."
      },
      {
        "vendor": "Microsoft",
        "product": "Viva Insights",
        "attack_vector": "motor_fatigue",
        "recommended_profile": "balanced_mode",
        "notes": "Workplace burnout detection via mouse/keyboard dynamics."
      },
      {
        "vendor": "Palantir",
        "product": "TeamSync Analytics",
        "attack_vector": "phase_stress_decoder",
        "recommended_profile": "maximum_defense",
        "notes": "Executive monitoring. Detects cognitive load via phase coherence analysis."
      },
      {
        "vendor": "BehavioSec",
        "product": "Fraud Detection",
        "attack_vector": "behavioral_biometrics",
        "recommended_profile": "balanced_mode",
        "notes": "Banking fraud prevention. Legitimate security use - balance protection vs UX."
      },
      {
        "vendor": "Neurable",
        "product": "Enten",
        "attack_vector": "attention_tracking",
        "recommended_profile": "maximum_defense",
        "notes": "Consumer headphones with EEG sensors. Focus tracking for 'productivity.'"
      }
    ]
  },
  "ethical_guidelines": {
    "description": "When to apply vs abstain from injection",
    "apply_defense": [
      "Covert profiling without informed consent",
      "Workplace surveillance (HR monitoring, productivity scoring)",
      "Educational surveillance (classroom attention tracking)",
      "Discriminatory hiring systems (neurodivergence detection)",
      "Emotional manipulation (targeted advertising based on stress/fatigue)",
      "Re-identification attacks on anonymized datasets"
    ],
    "abstain_from_defense": [
      "Explicit user consent with clear purpose limitation",
      "Therapeutic BCI applications (e.g., neurofeedback for ADHD)",
      "Accessibility tools (e.g., eye-tracking for ALS patients)",
      "Security systems where user is primary beneficiary (fraud prevention with user control)",
      "Research studies with IRB approval and opt-out mechanisms"
    ],
    "user_control": {
      "principle": "Defense should be user-controlled, not paternalistic",
      "implementation": "Provide clear UI to enable/disable per context, with explanations"
    }
  },
  "technical_parameters": {
    "lissajous_defaults": {
      "tremor_band_hz": [4, 12],
      "entropy_target_nats": 3.2,
      "freq_ratio": [13, 8],
      "phase_offset_rad": 1.5708,
      "canvas_bounds": [0.0, 1.0]
    },
    "spectral_defaults": {
      "alpha_band_hz": [8, 12],
      "theta_band_hz": [4, 8],
      "beta_band_hz": [12, 30],
      "injection_amplitude": 0.15,
      "target_snr_db": 6.0,
      "sampling_rate_hz": 256
    },
    "auditor_defaults": {
      "fingerprint_stability_threshold": 0.85,
      "gradient_entropy_threshold": 0.5,
      "feature_diversity_threshold": 0.3,
      "temporal_window_size": 10,
      "min_sessions_for_detection": 3
    }
  },
  "deployment_checklist": {
    "description": "Pre-deployment validation steps",
    "steps": [
      {
        "step": 1,
        "task": "Run biomimicry verification (lissajous_overlay.verify_biomimicry)",
        "acceptance": "spectral_entropy within 3.0-3.5 nats"
      },
      {
        "step": 2,
        "task": "Test gradient auditor on known benign system",
        "acceptance": "Zero false positives over 100 samples"
      },
      {
        "step": 3,
        "task": "Verify SNR on spectral injection",
        "acceptance": "SNR within 5-7 dB (maintains EEG quality)"
      },
      {
        "step": 4,
        "task": "User acceptance testing (UX degradation check)",
        "acceptance": "No perceptible latency or cursor jitter reported"
      },
      {
        "step": 5,
        "task": "Legal review of deployment context",
        "acceptance": "Deployment complies with local neurorights laws (see regulatory_compendium)"
      }
    ]
  },
  "future_roadmap": {
    "v5.1": {
      "features": [
        "Federated learning integration (contribute to defense model without sharing raw data)",
        "WebAssembly port (client-side execution in browsers)",
        "Mobile SDK (iOS/Android keystroke/touchscreen defense)"
      ],
      "eta": "Q2 2026"
    },
    "v6.0": {
      "features": [
        "Adversarial GAN training (co-evolve defense with simulated attackers)",
        "Zero-knowledge proof integration (prove humanity without revealing biometrics)",
        "Cross-modal defense (correlate cursor + voice + facial micro-expressions)"
      ],
      "eta": "Q4 2026"
    }
  }
}
